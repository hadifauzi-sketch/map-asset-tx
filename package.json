  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:link": "supabase link --project-ref rgtwfmhnnmkbsdjgtxjb",
    "globe:plants": "node scripts/build-power-plants.mjs",
    "data:centres": "node scripts/build-data-centres.mjs",
    "data:centres:malaysia": "node scripts/build-malaysia-data-centres.mjs",
    "globe:grid": "node scripts/build-power-grid.mjs",
    "grid:download": "node scripts/download-power-equipment.mjs && node scripts/build-power-grid.mjs",
    "globe:buildings": "python scripts/buildings3d/extract_buildings.py data/osm/malaysia.osm.pbf data/osm/buildings-extract.npz && python scripts/buildings3d/build_tileset.py data/osm/buildings-extract.npz public/data/buildings3d",
    "ext:sync": "node scripts/sync-firefox-extension.mjs",
    "ext:check": "node scripts/sync-firefox-extension.mjs --check",
    "ext:xpi": "node scripts/pack-firefox-xpi.mjs"
  }
}
