    "@supabase/supabase-js": "^2.103.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@xyflow/react": "^12.10.2",
    "cesium": "^1.147.0",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "openmeteo": "^1.2.3",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^15.0.0",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^3.1.1",
    "recharts": "^3.7.0",
