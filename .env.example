# ══════════════════════════════════════════════════
#  Transformer Asset Map — Environment Config
# ══════════════════════════════════════════════════
#  Copy this file to .env and fill in the values.
#  Never commit .env to Git — it is in .gitignore.
# ══════════════════════════════════════════════════

# ── Option A: Supabase Cloud (default) ────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Option B: Supabase Local Docker ───────────────
# After running `npm run db:start`, run `npm run db:status` to get the anon key.
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=<anon key from `supabase status` output>
